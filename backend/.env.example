# Database configuration

# DATABASE_URL format: postgresql://username:password@host:port/database_name
# - postgresql:// = the dabase type we're using
# - fomode_user = username for database access
# - your_password_here = password (CHANGE THIS!)
# - db = hostname (matches service name in docker-compose.yml)
# - 5432 = default PostgreSQL port
# - fomode_db = name of database
DATABASE_URL=postgresql://fomode_user:your_password_here@db:5432/fomode_db

# Application Settings
# Environment can be: development, production, testing
ENVIRONMENT=development

# API Settings
# The title that that appears in the auto-generated API documentation
API_TITLE=Fomode API
API_VERSION=0.1.0
API_DESCRIPTION="API for Fomode application"

# CORS Settings (for Flutter app communication)
# In development, we allow request from anywhere
# In production, restrict this to app's domain
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Security (for authentication)
# Secret key used to sign JWT tokens
# Generate a secure random string for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# Howl long JWT tokens last (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
